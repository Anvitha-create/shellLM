# shelLM Environment Configuration
# Copy this to .env and fill in your keys

# ── Provider API Keys (only fill the one you use) ──────────────────────────

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude (default provider)
ANTHROPIC_API_KEY=

# Ollama (local - no key needed, just set the URL)
OLLAMA_BASE_URL=http://localhost:11434

# E-INFRA / CESNET
EINFRA_API_KEY=

# PublicAI
PUBLICAI_API_KEY=
PUBLICAI_USER_AGENT=ShellM/1.0

# ── Optional Config ─────────────────────────────────────────────────────────

# Override default log directory
# LOG_DIR=logs

# Override default sessions directory  
# SESSIONS_DIR=sessions
